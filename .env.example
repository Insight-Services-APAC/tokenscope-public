# TokenScope local dev — example env. Copy to `.env` and edit.
#
# IMPORTANT: Nuxt's env loader (unjs/c12 → dotenv-expand) supports
# ${VAR} expansion but NOT POSIX ${VAR:-default} fallbacks. Replace the
# placeholder hostnames below by hand if you change CW_WORKER_NAME.

# ── Dev mode flags ──
NUXT_OIDC_AUTH_DEV_MODE=true
# Both are needed for the local persona grid, and the failure mode when this one
# is missing is silent-looking: the "Sign in as ..." buttons RENDER, the click
# returns 200, and you bounce straight back to /login. dev-login mints the
# ts_persona_override cookie, but server/utils/auth.ts only honours it when this
# is true — so without it every persona is a working login button that logs you
# into nothing.
NUXT_ALLOW_PERSONA_OVERRIDE=true
NUXT_TELEMETRY_DISABLED=1

# ── Session secrets (generate via: openssl rand -base64 48) ──
NUXT_SESSION_SECRET=replace-me-with-openssl-rand-base64-48

# ── Sibling services (resolved by name on the cw worker network) ──
# Hostnames match the container_name pattern in docker-compose.yml. The
# default cw worker is `tokenscope`; adjust the prefix if running
# under a different worker name (no env-var expansion happens here).
DATABASE_URL=postgresql://tokenscope:tokenscope@tokenscope-postgres:5432/tokenscope
REDIS_URL=redis://tokenscope-redis:6379
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://tokenscope-azurite:10000/devstoreaccount1;

# ── OTel + Azure Monitor (Epic 6 wires read path) ──
NUXT_AZURE_MONITOR_ENDPOINT=http://tokenscope-fake-azure-monitor:8080
NUXT_ANTHROPIC_API_ENDPOINT=http://tokenscope-synthetic-anthropic-api:8080
OTEL_EXPORTER_OTLP_ENDPOINT=http://tokenscope-otel-collector:4318

# Read-joiner: max instances scanned per azure-monitor-read tick (positive int;
# default 500). Raise if the "joinable-instance cap hit" worker warning fires.
# NUXT_JOINER_INSTANCE_CAP=500
# How recently an open instance must have minted an ingest bearer to be re-scanned
# regardless of enrolment age (hours; default 336 = 14d, min 1, max 2160 = 90d).
# NUXT_JOINER_LIVE_BEARER_HOURS=336

# HMAC session-token key — see server/auth/hmac.ts (32+ chars required).
NUXT_HMAC_SESSION_KEY=replace-me-with-openssl-rand-base64-48

# ── GitHub Enterprise reconciliation credential ──
# Design: docs/design/provider-billing-attribution-model.md
#
# PAT for reading a GitHub Enterprise's Copilot billing. The same var backs the
# existing GitHub reconciliation lane (resolveEnterpriseCredential) and the
# upcoming bill writer; consumed via credentials.ts envKeyForSecret, where the
# env var name is NUXT_GITHUB_PAT_<UPPER_SNAKE> of the provider_enterprise row's
# credential_secret_name (e.g. 'enterprise-nfr' → NUXT_GITHUB_PAT_ENTERPRISE_NFR).
#   - Type:  CLASSIC PAT, created by an enterprise billing manager / owner.
#   - Scope: `manage_billing:enterprise` (+ `read:org`) — validated against the
#            enterprise seats + usage-report + ai_credit/usage endpoints.
#
# NEVER commit a real value. Paste it into `.env.local` (gitignored) for local
# testing, and set the SAME variable in the sandbox + dev secrets (mirrors how the
# Anthropic admin key was wired — PR #93).
# NUXT_GITHUB_PAT_ENTERPRISE_NFR=
