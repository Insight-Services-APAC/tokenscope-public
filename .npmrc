# Refuse to install on the wrong runtime instead of warning about it.
#
# package.json declares "node": ">=24" / "npm": ">=11", but engines is ADVISORY by
# default: npm prints a warning and installs anyway. That is how a dev container sat
# on Node 22 after the repo moved to 24 (PR #196) while CI and the Dev Container Apps
# ran 24 — local test runs happening on a runtime that matched neither, with nothing
# saying so louder than a line of install noise.
#
# With this set, `npm ci` on Node 22 exits 1 with EBADENGINE naming both the required
# and the actual versions. Verified both directions: clean on Node 24 + npm 11,
# refuses on Node 22.
#
# Note this enforces engines for TRANSITIVE dependencies too, not just this package —
# a dep declaring a narrower range than our runtime will now fail the install rather
# than warn. The current tree is clean under that rule; if a future dep trips it, fix
# or replace the dep rather than deleting this line, because deleting it silently
# restores the drift above.
engine-strict=true
