{
  "name": "tokenscope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TokenScope — Usage-Based Token Attribution Platform (Insight). Slogan: Trust the developer. Track every token. Let the budget do the teaching.",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host 0.0.0.0 --port 3450",
    "dev:stack": "bash scripts/dev-stack.sh up",
    "dev:stack:down": "bash scripts/dev-stack.sh down",
    "dev:stack:status": "bash scripts/dev-stack.sh status",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx drizzle/migrate.ts",
    "db:seed": "tsx drizzle/seed.ts",
    "db:seed:regions": "tsx drizzle/seed-regions.ts",
    "db:seed:org-structure": "tsx drizzle/seed-org-structure.ts",
    "emit:data": "tsx scripts/emit-data.ts",
    "emit:stream": "tsx scripts/emit-stream.ts",
    "worker": "tsx scripts/run-worker.ts",
    "preview": "nuxt preview",
    "postinstall": "patch-package --error-on-fail --error-on-warn && nuxt prepare",
    "typecheck": "nuxt prepare && vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "sync:copilot-plugin": "node scripts/sync-copilot-plugin.mjs",
    "check:copilot-plugin-sync": "node scripts/check-copilot-plugin-sync.mjs",
    "sync:skill-prompts": "node scripts/sync-skill-prompts.mjs",
    "check:skill-prompts-sync": "node scripts/check-skill-prompts-sync.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "bash tests/e2e/run-e2e.sh",
    "test:fidelity": "bash tests/fidelity/check.sh",
    "test:smoke": "bash tests/smoke/run-smoke.sh"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/monitor-query": "^1.3.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nuxt/ui": "^4.7.0",
    "consola": "^3.4.2",
    "drizzle-orm": "^0.45.1",
    "echarts": "^6.1.0",
    "nuxt": "^4.4.2",
    "nuxt-echarts": "^1.0.1",
    "nuxt-oidc-auth": "1.0.0-beta.11",
    "nuxt-security": "^2.5.0",
    "postgres": "^3.4.8",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "vue": "^3.5.28",
    "vue-echarts": "^8.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.1",
    "@playwright/cli": "^0.1.13",
    "@playwright/test": "^1.58.2",
    "@testcontainers/postgresql": "^12.0.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "happy-dom": "^20.8.6",
    "patch-package": "^8.0.1",
    "playwright-chromium": "^1.58.2",
    "prettier": "^3.8.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1",
    "vue-tsc": "^3.3.0"
  },
  "overrides": {
    "tmp": ">=0.2.6",
    "esbuild": ">=0.25.0"
  }
}
