# TokenScope sandbox — env template.
#
# All secrets ride through Azure Key Vault references in the Bicep
# parameters file + Container Apps secrets block. This file documents
# the env-var contract; values come from Key Vault at runtime.

# ── Sandbox mode ──
NODE_ENV=production
NUXT_OIDC_AUTH_DEV_MODE=false
NUXT_TELEMETRY_DISABLED=1

# ── Entra OIDC (real, no dev-login) ──
NUXT_OIDC_TENANT_ID=<tenant-uuid>
NUXT_OIDC_CLIENT_ID=<app-registration-client-id>
# client secret lives in Key Vault, referenced from Container Apps secrets

# ── Backing services (Bicep-provisioned) ──
DATABASE_URL=postgresql://tokenscope_admin@<pg-fqdn>:5432/tokenscope?sslmode=require
REDIS_URL=rediss://:<key>@<redis-host>:6380

# ── Telemetry read path (Path B: Collector → Log Analytics → KQL) ──
# Sandbox selects the LogAnalyticsReader; local dev defaults to the
# collector-fed store (LocalCollectorReader).
NUXT_TELEMETRY_READER=log-analytics
# Log Analytics workspace customer GUID — monitoring.bicep output
# `logAnalyticsCustomerId`. The reader queries this via @azure/monitor-query.
NUXT_LOG_ANALYTICS_WORKSPACE_ID=<law-workspace-guid>
# User-assigned MI client id for DefaultAzureCredential (container-app.bicep
# `identityClientId`). RBAC: "Log Analytics Reader" on the LAW (read side) +
# "Monitoring Metrics Publisher" on the DCR (the /bearer ingest-token mint).
NUXT_AZURE_MI_CLIENT_ID=<user-assigned-mi-client-id>
# Ingest-token mint mode: 'mi' = real ManagedIdentityCredential (obo.ts);
# unset/anything-else = deterministic mock (local). Audience override via
# NUXT_AZURE_MONITOR_INGEST_SCOPE (default https://monitor.azure.com/.default).
NUXT_AZURE_MONITOR_AUTH=mi

# ── Azure Monitor / AMW OTLP ingest endpoint (the EMIT side) — where the
# OTel Collector forwards Claude's telemetry. Distinct from the LAW the
# reader queries above.
NUXT_AZURE_MONITOR_ENDPOINT=https://<amw-name>.<region>.monitor.azure.com

# ── Anthropic Admin API (real — swap from synthetic-anthropic-api) ──
NUXT_ANTHROPIC_API_ENDPOINT=https://api.anthropic.com
# x-api-key wired at Epic 10 swap of server/anthropic/client.ts

# ── Session HMAC + cookie secret — rotated from Key Vault ──
NUXT_HMAC_SESSION_KEY=<rotated-via-key-vault>
NUXT_SESSION_SECRET=<rotated-via-key-vault>

# ── Key Vault reference (read at boot for the OBO flow) ──
NUXT_KEY_VAULT_NAME=tokenscope-sandbox-kv
