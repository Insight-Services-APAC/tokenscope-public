# TokenScope — env contract of a DEPLOYED container (reference only).
#
# You do not fill this file in. On Azure, Bicep (infra/modules/container-app.bicep)
# sets every variable below on the container app; secrets are Key Vault
# references, never literal values. Use it to see what a running revision is
# given. Full descriptions: docs/CONFIGURATION.md. Deploy: docs/DEPLOY-AZURE.md.

# ── Runtime ──
NODE_ENV=production
NITRO_PORT=3000
NUXT_DEPLOY_ENV=<env param>
NUXT_PUBLIC_DEPLOY_ENV=<env param>
GIT_COMMIT_SHA=<gitCommitSha param, when set>

# ── Backing services (Key Vault secrets) ──
DATABASE_URL=<secret: database-url>
REDIS_URL=<secret: redis-url>

# ── App secrets (Key Vault secrets) ──
NUXT_SESSION_SECRET=<secret>
NUXT_HMAC_SESSION_KEY=<secret>
NUXT_INTERNAL_WORKER_HMAC_KEY=<secret>

# ── Entra sign-in ──
NUXT_OIDC_AUTH_DEV_MODE=false
NUXT_OIDC_PROVIDERS_ENTRA_CLIENT_ID=<entraIdClientId param>
NUXT_OIDC_PROVIDERS_ENTRA_REDIRECT_URI=<entraIdRedirectUri param>
# Authorization, token and logout URLs are composed from the tenant id.
NUXT_OIDC_PROVIDERS_ENTRA_AUTHORIZATION_URL=https://login.microsoftonline.com/<tenant>/oauth2/v2.0/authorize
NUXT_OIDC_PROVIDERS_ENTRA_TOKEN_URL=https://login.microsoftonline.com/<tenant>/oauth2/v2.0/token
NUXT_OIDC_PROVIDERS_ENTRA_LOGOUT_URL=https://login.microsoftonline.com/<tenant>/oauth2/v2.0/logout
NUXT_OIDC_PROVIDERS_ENTRA_LOGOUT_REDIRECT_URI=<redirect URI with /auth/entra/callback → /login>
NUXT_OIDC_PROVIDERS_ENTRA_CLIENT_SECRET=<secret, when set>
NUXT_OIDC_SESSION_SECRET=<secret, when set>
NUXT_OIDC_AUTH_SESSION_SECRET=<secret, when set>
NUXT_OIDC_TOKEN_KEY=<secret, when set>
NUXT_ALLOW_PERSONA_OVERRIDE=<allowPersonaOverride param: true|false>
NUXT_BOOTSTRAP_ADMIN_EMAIL=<bootstrapAdminEmail param>

# ── Telemetry ──
# Devices send OTLP straight to the Azure Monitor Data Collection Endpoint (no
# collector). The server hands this URL to each device at provision time:
# <DCE logs ingestion endpoint>/dataCollectionRules/<DCR immutable id>/streams/Microsoft-OTLP-Logs/otlp/v1/logs
NUXT_AZURE_MONITOR_LOGS_ENDPOINT=<DCE logs URL, set by Bicep>
# The read-joiner queries Log Analytics with the user-assigned managed identity.
NUXT_TELEMETRY_READER=log-analytics
NUXT_LOG_ANALYTICS_WORKSPACE_ID=<workspace customer id>
NUXT_AZURE_MI_CLIENT_ID=<managed identity client id>
NUXT_AZURE_MONITOR_AUTH=mi
NUXT_AZURE_DCR_RESOURCE_ID=<DCR resource id>
APPLICATIONINSIGHTS_CONNECTION_STRING=<from monitoring>

# ── Identity, networking, Front Door ──
AZURE_CLIENT_ID=<managed identity client id>
AZURE_KEYVAULT_URL=<Key Vault URI>
AZURE_FRONT_DOOR_ID=<frontDoorId param; empty = no enforcement>
NUXT_SECURITY_RATE_LIMITER_IP_HEADER=<x-azure-clientip when Front Door is enforced>
APP_PUBLIC_ORIGIN=<appPublicOrigin param>
MCP_ALLOWED_HOSTS=<mcpAllowedHosts param>

# ── Providers and directory ──
NUXT_ANTHROPIC_API_ENDPOINT=<anthropicApiEndpoint param; empty = poller no-op>
NUXT_GRAPH_DIRECTORY_MODE=graph
# Provider credentials (Anthropic admin key, GitHub PATs / App keys) and the
# optional app-role and alerting variables are added only when their parameters
# are set; see infra/modules/container-app.bicep for the exact list.
